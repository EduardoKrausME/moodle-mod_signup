{{!
    @template mod_signup/group_cards

    Example context (json):
    {
        *Example context (json):*
    }
}}
{{#hasteacherbuttons}}
    <div class="d-flex flex-wrap gap-2 mb-3">
        {{#canmanage}}
            <a class="btn btn-secondary" href="{{{manageurl}}}">{{#str}}managegroups, mod_signup{{/str}}</a>{{/canmanage}}
        {{#canreport}}<a class="btn btn-outline-secondary" href="{{{reporturl}}}">{{#str}}
            report, mod_signup{{/str}}</a>{{/canreport}}
    </div>
{{/hasteacherbuttons}}

{{^open}}
    <div class="alert alert-info">{{closedreason}}</div>
{{/open}}

<div class="mod-signup-grid">
    {{#groups}}
        <section class="card mod-signup-card {{#iscurrent}}border-primary{{/iscurrent}}">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <h3 class="h5 card-title mb-1">{{name}}</h3>
                    {{#iscurrent}}
                        <span class="badge bg-primary">{{#str}}currentselection, mod_signup{{/str}}</span>{{/iscurrent}}
                </div>
                <div class="small text-muted mb-3">{{confirmed}} / {{capacity}} {{#str}}
                    confirmed, mod_signup{{/str}}</div>

                {{#notfull}}
                    <div class="mb-2"><strong>{{remaininglabel}}</strong></div>
                {{/notfull}}
                {{#full}}
                    <div class="mb-2"><span class="badge bg-secondary">{{#str}}full, mod_signup{{/str}}</span>
                    </div>{{/full}}
                {{#haswaiting}}
                    <div class="small mb-2">{{#str}}waiting, mod_signup{{/str}}: {{waiting}}</div>{{/haswaiting}}
                {{#allowleader}}
                    {{#hasleader}}
                        <div class="small mb-2"><strong>{{#str}}leader, mod_signup{{/str}}:</strong> {{leadername}}
                        </div>{{/hasleader}}
                    {{^hasleader}}
                        <div class="small text-muted mb-2">{{#str}}noleader, mod_signup{{/str}}</div>{{/hasleader}}
                {{/allowleader}}

                {{#currentwaiting}}
                    <div class="alert alert-warning py-2 mt-2 mb-2">{{waitpositionlabel}}</div>
                {{/currentwaiting}}
                {{#currentconfirmed}}
                    <div class="alert alert-success py-2 mt-2 mb-2">{{#str}}confirmed, mod_signup{{/str}}</div>
                {{/currentconfirmed}}

                <div class="mt-auto pt-2">
                    {{#canjoin}}
                        <form method="post" action="{{actionurl}}" class="mb-2">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <input type="hidden" name="id" value="{{cmid}}">
                            <input type="hidden" name="groupid" value="{{id}}">
                            <input type="hidden" name="action" value="join">
                            <button class="btn btn-primary w-100" type="submit">{{joinlabel}}</button>
                        </form>
                    {{/canjoin}}
                    {{#canconfig}}
                        <a class="btn btn-outline-secondary w-100" href="{{{settingsurl}}}">{{#str}}
                            teamsettings, mod_signup{{/str}}</a>
                    {{/canconfig}}
                </div>
            </div>
        </section>
    {{/groups}}
</div>

{{#canleave}}
    <form method="post" action="{{actionurl}}" class="mt-3">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="id" value="{{cmid}}">
        <input type="hidden" name="action" value="leave">
        <button class="btn btn-outline-danger" type="submit">{{#str}}leavebutton, mod_signup{{/str}}</button>
    </form>
{{/canleave}}
